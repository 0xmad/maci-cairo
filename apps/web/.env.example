# Local Starknet RPC. In `pnpm dev`, loopback :5050 is proxied as /starknet-rpc (avoids CORS).
VITE_RPC_URL=http://127.0.0.1:5050/
VITE_NETWORK_ID=local

# Sepolia RPC (switcher option is disabled for now)
VITE_SEPOLIA_RPC_URL=https://starknet-sepolia.public.blastapi.io

# Ops backend. In `pnpm dev`, loopback :8787 is proxied as /ops (avoids CORS).
VITE_BACKEND_OPS_URL=http://127.0.0.1:8787
