POSTGRES_USER=maci
POSTGRES_PASSWORD=maci
POSTGRES_DB=maci_ops
# Host `pnpm start`: 127.0.0.1. Compose `ops` overrides this to the `postgres` service.
DATABASE_URL=postgres://maci:maci@127.0.0.1:5432/maci_ops
JWT_SECRET=dev-jwt-secret
# Host process: 127.0.0.1. Compose `ops` reaches host RPC via host.docker.internal.
STARKNET_RPC_URL=http://127.0.0.1:5050
STARKNET_CHAIN_ID=SN_SEPOLIA
OPERATOR_ALLOWLIST=
PORT=8787
