{
  "name": "maci",
  "version": "0.1.0",
  "description": "Minimal Anti-Collusion Infrastructure",
  "repository": "https://github.com/privacy-scaling-explorations/maci",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "types": "pnpm -r types",
    "build:circuits-c": "pnpm -r exec build-test-circuits-c --scope \"maci-circuits\"",
    "build:circuits-wasm": "pnpm -r exec build-test-circuits-wasm --scope \"maci-circuits\"",
    "prettier": "prettier -c .",
    "prettier:fix": "prettier -w .",
    "lint:ts": "eslint './**/**/*.ts'",
    "lint:ts:fix": "pnpm run lint:ts --fix",
    "clean": "pnpm exec -- rm -rf node_modules build && rm -rf node_modules",
    "prepare": "is-ci || husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/compat": "^2.1.0",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": "24 || 26",
    "pnpm": "11"
  }
}
