  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "types": "tsc -p tsconfig.json --noEmit",
    "build:garaga": "docker build -t garaga .",
    "test": "vitest --run",
    "compile:ballot": "circomkit compile Ballot",
