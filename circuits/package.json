    "circomkit": "^0.3.4",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "ffjavascript": "^0.3.1",
    "poseidon-lite": "^0.3.0",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@types/circomlibjs": "^0.1.6",
    "@types/node": "^26.2.0",
    "@types/snarkjs": "^0.7.9",
    "@vitest/coverage-v8": "4.1.4",
    "fast-check": "^4.6.0",
    "vitest": "^4.1.4"
